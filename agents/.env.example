# YuktiOps Agent Service Configuration

# Service & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL / SQLite fallback for instant zero-dependency local runs)
# For local Postgres: postgresql+asyncpg://yuktiops_user:yuktiops_secret@localhost:5432/yuktiops
# For instant local SQLite (no Docker needed): sqlite+aiosqlite:///./yuktiops.db
DATABASE_URL=sqlite+aiosqlite:///./yuktiops.db

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# LLM Provider (OpenAI, Groq, or OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Limits
MAX_DIFF_LINES=1200
MAX_DIFF_BYTES=60000
SEVERITY_NOTIFICATION_THRESHOLD=HIGH
