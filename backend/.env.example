# YuktiOpsAI Backend Configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env to source control.

# ── Service ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Production (Supabase direct connection):
#   DATABASE_URL=postgresql+asyncpg://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local SQLite fallback (zero-dependency local dev only):
#   DATABASE_URL=sqlite+aiosqlite:///./yuktiops_backend.db
DATABASE_URL=sqlite+aiosqlite:///./yuktiops_backend.db

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=yuktiopsai-d1f6f
# Path to service account JSON file (relative to backend or absolute):
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
# Alternatively, paste the entire service account JSON as a single-line string:
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Optional — used for outbound alert notifications:
TELEGRAM_ALERT_CHAT_ID=
# Secret for validating incoming webhook requests from Telegram:
TELEGRAM_WEBHOOK_SECRET=
# Your public HTTPS base URL (e.g. from ngrok) required for webhook registration:
PUBLIC_BASE_URL=

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM key as single-line with \n escapes, or leave empty:
GITHUB_APP_PRIVATE_KEY=

# ── LLM Provider (OpenAI-compatible) ─────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Reddit (PRAW OAuth2 — Script App) ────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=YuktiOpsAI/0.2 (hackathon research bot)

# ── LinkedIn ─────────────────────────────────────────────────────────────────
# LinkedIn's API restricts arbitrary public-post search.
# Only member-authorized tokens are supported; leave blank if unavailable.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ── Rewarded Ads ─────────────────────────────────────────────────────────────
# REWARDED_ADS_TEST_MODE=true bypasses provider verification (dev only).
REWARDED_ADS_TEST_MODE=true
ADMOB_SERVER_SIDE_VERIFICATION_SECRET=

# ── Credits & Referrals (product decisions — change to real values) ──────────
CREDIT_COST_FULL_SOLUTION=10
CREDIT_COST_SOCIAL_RESEARCH=5
CREDIT_REFERRAL_REWARD=20
CREDIT_REFERRAL_REFEREE_REWARD=10
CREDIT_NEW_USER_GRANT=50
REWARDED_AD_UNLOCK_DURATION_SECONDS=3600
REWARDED_AD_ELIGIBLE_FEATURES=full_solution,social_research

# ── Agents Service (for proxying GitHub analysis requests) ───────────────────
AGENTS_BASE_URL=http://localhost:8000
